{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Pic Shrinker",
  "version": "../package.json",
  "identifier": "io.github.uzairasad.picshrinker",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:3000",
    "beforeBuildCommand": "npm run build:desktop",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Pic Shrinker",
        "width": 1360,
        "height": 860,
        "minWidth": 360,
        "minHeight": 400,
        "center": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDYyRjk2QjlDQTJGRTgyRjkKUldUNWd2NmluR3Y1WXF5L2lhZzBTLzJoYmE5UDdETGt6VFEyTVlxS25TcWN2VDlBTmVLZVBxVEQK",
      "endpoints": ["https://github.com/uzairasad/pic-shrinker/releases/latest/download/latest.json"],
      "windows": {
        "installMode": "passive"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Photography",
    "shortDescription": "Fast, private image compression, created by Uzair Asad",
    "longDescription": "Pic Shrinker compresses JPEG, PNG, WebP, AVIF, HEIC and TIFF pictures on your own computer with MozJPEG, WebP, AVIF and OxiPNG. Live before/after comparison with a quality score, automatic \"looks identical\" quality, target file sizes, Lanczos resizing, EXIF and GPS control, and batch processing of whole folders. Created by Uzair Asad.",
    "copyright": "Copyright © 2026 Uzair Asad",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false
      }
    },
    "linux": {
      "deb": {
        "depends": []
      }
    },
    "macOS": {
      "minimumSystemVersion": "10.15"
    },
    "publisher": "Uzair Asad",
    "license": "GPL-3.0-or-later",
    "licenseFile": "../LICENSE",
    "homepage": "https://uzairasad.github.io/pic-shrinker/"
  }
}
